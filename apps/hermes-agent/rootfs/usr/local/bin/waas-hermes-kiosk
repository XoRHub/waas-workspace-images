#!/usr/bin/env bash
# Session of the hermes-agent image when WAAS_HERMES_DASHBOARD=1 (exec'd
# by waas-hermes-session): Firefox kiosk on the local Hermes dashboard
# (supervised by 60-hermes-dashboard.sh). supervisord starts both
# concurrently, so wait for the port; if it never comes up (crashed) fall
# back to the plain TUI so the session always lands somewhere usable.
set -euo pipefail

DASHBOARD_URL="http://127.0.0.1:9119"

for _ in $(seq 1 60); do
    if curl -sf -o /dev/null --max-time 1 "${DASHBOARD_URL}"; then
        exec firefox "${DASHBOARD_URL}"
    fi
    sleep 0.5
done

echo "waas-hermes-kiosk: dashboard not reachable after 30s — falling back to the hermes TUI" >&2
exec xterm -fa monospace -fs 12 -e hermes
